# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/socialapp?retryWrites=true&w=majority

# Secret used to sign JWTs - use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

PORT=5000

# Comma-separated list of allowed frontend origins (Vercel/Netlify URL)
CLIENT_ORIGINS=http://localhost:5173
